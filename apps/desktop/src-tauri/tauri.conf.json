{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameTrainer Studio",
  "version": "0.1.0",
  "identifier": "io.github.gametrainer.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GameTrainer Studio · M0 Mock",
        "width": 1500,
        "height": 930,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
